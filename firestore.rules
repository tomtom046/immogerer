rules_version = '2';

// Règles de sécurité Firestore pour ImmoGérer.
// À copier dans la console Firebase : Firestore Database > Règles > Publier.
// Chaque utilisateur ne peut lire et écrire que ses propres données ; tout le reste est refusé.
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{app}/users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
